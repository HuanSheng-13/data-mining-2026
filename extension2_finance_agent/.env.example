# Copy to extension2_finance_agent/.env and fill in your key locally.
# The project .env is loaded automatically and ignored by Git.
FINANCEQA_API_KEY=
FINANCEQA_CHAT_URL=https://api.deepseek.com/chat/completions
FINANCEQA_MODEL=deepseek-flash
# Independent evaluator credentials; never included in Agent tools/context.
FINANCEQA_JUDGE_API_KEY=
FINANCEQA_JUDGE_URL=https://api.deepseek.com/chat/completions
FINANCEQA_JUDGE_MODEL=deepseek-flash
