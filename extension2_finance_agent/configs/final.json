{
  "data_root": "data/financeqa/FinanceQA",
  "artifacts_dir": "extension2_finance_agent/artifacts/final",
  "chat_url": "https://api.deepseek.com/chat/completions",
  "model": "deepseek-flash",
  "api_key_env": "FINANCEQA_API_KEY",
  "temperature": 0,
  "max_tokens": 3000,
  "max_turns": 16,
  "max_tool_calls": 24,
  "timeout_seconds": 90,
  "retries": 2,
  "tool_factory": "extension2_finance_agent.tools.data:create_tools",
  "prepare_factory": "extension2_finance_agent.prepare.reports:prepare",
  "validate_factory": "extension2_finance_agent.prepare.reports:validate_artifacts",
  "strategy_factory": "extension2_finance_agent.strategies.finance:create_strategy",
  "prompt_file": "extension2_finance_agent/prompts/agent.txt",
  "skill_files": [
    "extension2_finance_agent/skills/financial_basis.txt",
    "extension2_finance_agent/skills/calculation_and_claims.txt",
    "extension2_finance_agent/skills/recovery_and_stop.txt"
  ]
}
