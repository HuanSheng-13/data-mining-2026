{
  "data_root": "data/financeqa/FinanceQA",
  "artifacts_dir": "extension2_finance_agent/artifacts/data_optimized",
  "chat_url": "https://api.deepseek.com/chat/completions",
  "model": "deepseek-flash",
  "api_key_env": "FINANCEQA_API_KEY",
  "temperature": 0,
  "max_tokens": 2500,
  "max_turns": 12,
  "max_tool_calls": 16,
  "timeout_seconds": 60,
  "retries": 2,
  "tool_factory": "extension2_finance_agent.tools.optimized:create_tools",
  "prepare_factory": "extension2_finance_agent.prepare.optimized:prepare",
  "validate_factory": "extension2_finance_agent.prepare.optimized:validate_artifacts",
  "strategy_factory": "extension2_finance_agent.strategies.baseline:create_strategy",
  "prompt_file": "extension2_finance_agent/prompts/baseline.txt",
  "skill_files": []
}
